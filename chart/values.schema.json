{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Weber Helm chart values",
  "description": "Validated at install time, so a typo fails with a clear message instead of a nil-pointer deep inside a template. Adopted from ml-hub, which inherits the pattern from Zero to JupyterHub K8s.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },

    "gateway": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "resources": { "$ref": "#/definitions/resources" },
        "probes": {
          "type": "object",
          "properties": { "path": { "type": "string" } }
        }
      }
    },

    "core": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "service": {
          "type": "object",
          "properties": { "port": { "type": "integer", "minimum": 1, "maximum": 65535 } }
        },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "size": { "type": "string" },
            "storageClassName": { "type": "string" },
            "accessModes": { "type": "array", "items": { "type": "string" } }
          }
        },
        "resources": { "$ref": "#/definitions/resources" },
        "seed": { "type": "boolean" }
      }
    },

    "toolchains": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },

    "auth": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "githubClientId": { "type": "string" },
        "allowedLogins": { "type": "string" },
        "existingSecret": { "type": "string" },
        "sessionSecret": { "type": "string" }
      }
    },

    "gitlab": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "externalUrl": { "type": "string" },
        "image": {
          "type": "object",
          "properties": { "repository": { "type": "string" }, "tag": { "type": "string" } }
        },
        "resources": { "$ref": "#/definitions/resources" },
        "persistence": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" }, "size": { "type": "string" } }
        }
      }
    },

    "judge0": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "properties": { "repository": { "type": "string" }, "tag": { "type": "string" } }
        },
        "service": {
          "type": "object",
          "properties": { "port": { "type": "integer", "minimum": 1, "maximum": 65535 } }
        },
        "resources": { "$ref": "#/definitions/resources" },
        "existingSecret": { "type": "string" },
        "postgres": {
          "type": "object",
          "properties": {
            "host": { "type": "string" },
            "database": { "type": "string" },
            "username": { "type": "string" }
          }
        },
        "redis": {
          "type": "object",
          "properties": { "host": { "type": "string" } }
        }
      }
    },

    "dsh": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "properties": { "repository": { "type": "string" }, "tag": { "type": "string" } }
        },
        "service": {
          "type": "object",
          "properties": { "port": { "type": "integer", "minimum": 1, "maximum": 65535 } }
        },
        "resources": { "$ref": "#/definitions/resources" },
        "existingSecret": { "type": "string" }
      }
    },

    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": { "type": "string" },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "type": "string", "enum": ["Prefix", "Exact", "ImplementationSpecific"] }
                  }
                }
              }
            }
          }
        },
        "tls": { "type": "array" }
      }
    },

    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "cloudMetadata": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" }, "ip": { "type": "string" } }
        },
        "coreEgress": { "type": "array" }
      }
    },

    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "gateway": { "$ref": "#/definitions/budget" },
        "core": { "$ref": "#/definitions/budget" }
      }
    },

    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },

    "workspaceLimits": {
      "type": "object",
      "description": "Per-user limits enforced by the application, distinct from the Kubernetes limits above.",
      "properties": {
        "maxConcurrentActions": { "type": "integer", "minimum": 1 },
        "maxDiskBytes": { "type": "integer", "minimum": 1 },
        "maxActionsPerMinute": { "type": "integer", "minimum": 1 },
        "maxNotebookRows": { "type": "integer", "minimum": 1 },
        "maxNotebookCells": { "type": "integer", "minimum": 1 }
      }
    }
  },

  "definitions": {
    "resources": {
      "type": "object",
      "description": "Requests and limits are both required: requests schedule the pod, limits contain it. A pod with neither can starve a shared cluster.",
      "properties": {
        "requests": { "type": "object" },
        "limits": { "type": "object" }
      },
      "required": ["requests", "limits"]
    },
    "budget": {
      "type": "object",
      "properties": { "minAvailable": { "type": "integer", "minimum": 0 } }
    }
  }
}
