# Copy to .env for local configuration. Real environment files are git-ignored.

# podman-compose publishes only the web edge on this port.
WEB_PORT=3000

# Core server settings (the Compose file supplies container-specific values).
CORE_HOST=0.0.0.0
CORE_PORT=8787
PORT=
WORKSPACE_ROOT=/workspaces
WEB_ORIGIN=http://localhost:3000
WEBER_SEED=1
WEBER_SANDBOX=0
WEBER_VERSION=0.1.0
WEBER_WEB_ROOT=

# Optional GitHub sign-in. Set credentials only in your private .env.
GITHUB_CLIENT_ID=
WEBER_ALLOWED_LOGINS=
WEBER_SESSION_SECRET=

# Optional GitHub API access for scripts/file-issues.ts.
GITHUB_TOKEN=