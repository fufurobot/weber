coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# TypeScript v1 declaration files
typings/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# ---------------------------------------------------------------------------
# Secrets. NEVER commit real credentials.
#
# `.env` and every variant (.env.local, .env.production, compose/.env, ...)
# is ignored. Only the checked-in templates below are tracked, and they must
# contain placeholders — never live values.
# ---------------------------------------------------------------------------
.env
.env.*
*.env

# Credential-ish files that are never needed in this repository.
*.pem
*.key
secrets/
credentials.json
service-account*.json

# Templates stay tracked (must be last so they win over the rules above).
!.env.example
!*.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt
dist

# Browser smoke test artifacts. The screenshot is uploaded by CI as a build
# artifact rather than committed; it only exists to explain a failure.
browser-smoke.png
playwright-report/
test-results/

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and *not* Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port
