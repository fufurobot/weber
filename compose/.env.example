# Weber compose configuration — copy to .env and adjust.
#
#   cp compose/.env.example compose/.env

# Host port for the nginx edge. This is the only published port.
WEB_PORT=3000

# Port the Bun core listens on inside the container network.
CORE_PORT=8787

# Where user projects live inside the core container (backed by a volume).
WORKSPACE_ROOT=/workspaces

# Public origin of the edge, used for CORS/origin checks.
WEB_ORIGIN=http://localhost:3000

# 1 = execute notebook/terminal cells in a restricted sandbox.
WEBER_SANDBOX=0
